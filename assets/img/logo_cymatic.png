<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 120" width="400" height="120">
    <defs>
        <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#00ffcc;stop-opacity:1" />
            <stop offset="50%" style="stop-color:#a855f7;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#ff00cc;stop-opacity:1" />
        </linearGradient>
    </defs>
    <!-- Símbolo / Icono (círculo + ondas) -->
    <circle cx="60" cy="60" r="40" fill="none" stroke="url(#logoGrad)" stroke-width="4" opacity="0.3"/>
    <circle cx="60" cy="60" r="28" fill="none" stroke="url(#logoGrad)" stroke-width="3"/>
    <circle cx="60" cy="60" r="16" fill="none" stroke="url(#logoGrad)" stroke-width="2"/>
    <path d="M60 20 Q70 40 60 60 Q50 80 60 100" stroke="url(#logoGrad)" stroke-width="2" fill="none"/>
    <path d="M60 20 Q50 40 60 60 Q70 80 60 100" stroke="url(#logoGrad)" stroke-width="2" fill="none" opacity="0.5"/>
    
    <!-- Texto CYMATIC STUDIO -->
    <text x="130" y="70" font-family="'Space Grotesk', 'Inter', sans-serif" font-size="42" font-weight="900" fill="url(#logoGrad)" letter-spacing="-1">
        CYMATIC
    </text>
    <text x="130" y="100" font-family="'Space Grotesk', 'Inter', sans-serif" font-size="18" font-weight="300" fill="#64748b" letter-spacing="4">
        STUDIO
    </text>
</svg>
